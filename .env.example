# Copy to `.env` (gitignored) and fill in locally. Never commit real keys.

# Generation provider. Leaving LLM_API_KEY empty puts generation in stub mode:
# the service answers with an explicit stub response instead of calling a provider.
# `make check` never calls a paid API.
LLM_API_KEY=

LLM_MODEL=

LLM_BASE_URL=https://api.example.com/v1

# Retrieval / answering knobs read by the app config.
LUMEN_TOP_K=5

# Raw retrieval score below which the system abstains. Left empty on purpose:
# the threshold is chosen from eval/report.md, not guessed here.
LUMEN_ABSTAIN_THRESHOLD=
